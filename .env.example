# NEXUS (Codename) - Environment Variables Template
# Copy this file to .env and fill in values - NEVER commit .env
# This is scaffold only - no real LLM calls yet

# --- Core ---
ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
NEXUS_DEV_TOKEN=dev-token-change-me-not-used-in-url

# --- Database ---
# PostgreSQL + pgvector (Docker Compose)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS
NEXT_PUBLIC_CODENAME_NOTE=Codename - Public name TBD

# --- Model Providers (Placeholders - No real calls in scaffold) ---
# These are placeholders for future ModelProvider implementations
# Do NOT put real keys in repo, use .env only
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
ARENA_API_KEY=
ARENA_BASE_URL=

# OpenAI-compatible provider covers Arena, Groq, Together, etc. via base_url override
MODEL_DEFAULT_PROVIDER=openai-compatible
MODEL_DEFAULT_NAME=gpt-4o-mini

# --- Embedding Provider (Local-first, replaceable) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# For future OpenAI-compatible embedding:
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=text-embedding-3-small

# --- MCP Servers (Scaffold - No real connections) ---
# Transport: stdio for local, streamable_http for remote, sse_legacy only
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_TRANSPORT=stdio
MCP_FETCH_ENABLED=true
MCP_FETCH_TRANSPORT=streamable_http
MCP_FETCH_URL=http://localhost:3001/mcp

# --- SandboxService ---
SANDBOX_SERVICE_TYPE=placeholder
SANDBOX_WORKSPACE_ROOT=/tmp/nexus-workspaces
SANDBOX_CONTAINER_RUNTIME=docker
SANDBOX_TIMEOUT_SECONDS=30

# --- Auth Security (Scaffold) ---
# Development Bearer token - NEVER in URL query param
# For WS, use initial auth message after connection, not ?token=SECRET
# See docs/architecture.md and apps/api/app/core/security.py for approach
AUTH_MODE=bearer_token
AUTH_TOKEN_HEADER=X-Nexus-Token
# AUTH_TOKEN is read from NEXUS_DEV_TOKEN env, not hardcoded

# --- Observability (Scaffold) ---
OTEL_ENABLED=false
OTEL_EXPORTER=console
LOG_LEVEL=info

# --- Feature Flags (Scaffold) ---
FEATURE_MCP=false
FEATURE_RAG=false
FEATURE_REAL_LLM=false
